[database]
host = localhost
port = 3306
database = aws_inventory
user = your-db-user
password = your-db-password

# One section per AWS account. Each needs ONE of: access_key+secret_key, profile, or role_arn.
# The first access_key/secret_key account is used as the STS source identity
# for all role_arn accounts.

[account:central]
access_key = AKIAXXXXXXXXXXXXXXXX
secret_key = your-secret-key
regions = us-east-1,us-west-2

[account:production]
role_arn = arn:aws:iam::123456789012:role/InventoryReadOnly
regions = us-east-1,us-west-2
# Optional collector flags (defaults shown)
# s3_collect = true
# ecs_collect = true
# eks_collect = false
# cloudfront_collect = true

[account:development]
profile = my-aws-profile
regions = us-west-2

# Optional: only needed for collect_sso.py (IAM Identity Center)
# [identity_center]
# instance_arn = arn:aws:sso:::instance/ssoins-xxxxxxxxxxxxxxxx
# identity_store_id = d-xxxxxxxxxx
# profile = my-aws-profile
